/dts-v1/;
/plugin/;

/ {
	metadata {
		title = "BTT Pi TFT50 V2.1";
		compatible = "radxa,dragon-q6a";
		category = "display";
		exclusive = "mdss_dsi", "gpio80";
		description = "LCD power, DSI panel and I2C touchscreen with polling.";
	};
};

&{/} {
	bridge_reg: bridge-regulator {
		compatible = "regulator-fixed";
		regulator-name = "bridge-reg";
		gpio = <&display_reg 0 0 /* active high */>;
		vin-supply = <&display_reg>;
		enable-active-high;
	};

	panel@0 {
		compatible = "raspberrypi,7inch-dsi";
		backlight = <&display_reg>;
		power-supply = <&display_reg>;
		port {
			panel_in: endpoint {
				remote-endpoint = <&panel_bridge_out>;
			};
		};
	};
};

&mdss {
	status = "okay";
};

&mdss_dsi {
	vdda-supply = <&vreg_l6b_1p2>;
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	bridge@0 {
		compatible = "toshiba,tc358762";
		reg = <0>;
		vddc-supply = <&bridge_reg>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi1: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				panel_bridge_out: endpoint {
					remote-endpoint = <&panel_in>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel_in_dsi1>;
	data-lanes = <0>;
};

&mdss_dsi_phy {
	vdds-supply = <&vreg_l10c_0p88>;
	status = "okay";
};

&qupv3_id_1 {
	status = "okay";
};

&i2c13 {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	display_reg: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	touch-controller@38 {
		compatible = "edt,edt-ft5406";
		reg = <0x38>;

		touchscreen-size-x = < 800 >;
		touchscreen-size-y = < 480 >;

		vcc-supply = <&display_reg>;
		reset-gpio = <&display_reg 1 1 /* active low */>;
		/* The adapter has no usable touch IRQ. edt-ft5x06 polls at 17 ms. */

		touchscreen-inverted-x;
		touchscreen-inverted-y;
	};
};

/* Q6A V1.21 J10: GPIO80 (LCD_VCC_EN) enables the LCD's 3.3 V rail. */
&tlmm {
	btt-tft50-lcd-power-hog {
		gpio-hog;
		gpios = <80 0>;
		output-high;
		line-name = "btt-tft50-lcd-power";
	};
};
